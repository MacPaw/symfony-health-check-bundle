{
    "name": "macpaw/symfony-health-check-bundle",
    "description": "Symfony health check bundle",
    "homepage": "https://github.com/MacPaw/symfony-health-check-bundle",
    "type": "symfony-bundle",
    "keywords": [
        "MacPaw",
        "Symfony",
        "monitoring",
        "healthcheck",
        "doctrine",
        "Symfony-Health-Check",
        "Symfony-Health-Check-Bundle",
        "Symfony-Health-Check-Doctrine"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Yozhef Hisem",
            "email": "hisemjo@gmail.com",
            "homepage": "https://macpaw.com/",
            "role": "Software Engineer"
        },
        {
            "name": "Ivan Hisem",
            "email": "2yonchi@gmail.com",
            "homepage": "https://macpaw.com/",
            "role": "Software Engineer"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^6.4 || ^7.4"
    },
    "require-dev": {
        "ext-json": "*",
        "phpstan/phpstan": "1.11.*",
        "squizlabs/php_codesniffer": "3.7.*",
        "phpunit/phpunit": "^10.5",
        "symfony/yaml": "^6.4 || ^7.4",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/cache": "^6.4 || ^7.4",
        "predis/predis": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "SymfonyHealthCheckBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymfonyHealthCheckBundle\\Tests\\": "tests"
        }
    },
    "scripts": {
        "composer-validate": [
            "composer validate"
        ],
        "cs": [
            "vendor/bin/phpcs"
        ],
        "cs-fix": [
            "vendor/bin/phpcbf"
        ],
        "phpstan": [
            "vendor/bin/phpstan analyse"
        ],
        "phpunit": [
            "vendor/bin/phpunit"
        ]
    }
}
